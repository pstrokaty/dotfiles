#!/usr/bin/env python3
import argparse, colorsys, json, os, pathlib, re, subprocess, sys

try:
    from PIL import Image
except ImportError:
    vp = pathlib.Path.home() / ".config/hypr/scripts/venv/bin/python"
    if vp.exists() and sys.executable != str(vp):
        os.execv(str(vp), [str(vp), *sys.argv])
    Image = None

home = pathlib.Path.home()
conf = home / ".config/kitty/themes/noctalia.conf"
walls_root = home / "Obrazy/Wallpapers"
profiles_dir = home / ".config/OpenRGB/profiles"
base_profile = profiles_dir / "DEFAULT.json"
target_profile = profiles_dir / "NoctaliaSync.json"
cache_dir = home / ".cache/wallfx"
state_file = cache_dir / "g213-mode"
modes_file = cache_dir / "g213-modes.json"
wall_cache_file = cache_dir / "g213-cache.json"

def parse_noctalia():
    c = {}
    if conf.exists():
        for line in conf.read_text(encoding="utf-8").splitlines():
            m = re.match(r"^([a-zA-Z0-9_]+)\s+#([0-9a-fA-F]{6})", line.strip())
            if m: c[m.group(1)] = m.group(2).lower()
    return c

def hex_to_hsv(h):
    return colorsys.rgb_to_hsv(int(h[0:2], 16)/255.0, int(h[2:4], 16)/255.0, int(h[4:6], 16)/255.0)

def hsv_to_hex(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))
    return f"{int(round(r*255)):02x}{int(round(g*255)):02x}{int(round(b*255)):02x}"

def is_green(h):
    hue, sat, _ = hex_to_hsv(h)
    return sat > 0.22 and 62.0 <= hue * 360.0 <= 165.0

def uniq(items):
    out = []
    for x in items:
        if x and x not in out: out.append(x)
    return out

def pad5(items, p):
    res = list(items)
    h, s, v = hex_to_hsv(p)
    vars_ = [p, hsv_to_hex(h, min(1.0, s*1.1), min(1.0, v*1.15)), hsv_to_hex(h+0.04, s, v), hsv_to_hex(h-0.04, s, max(0.35, v*0.85)), hsv_to_hex(h, max(0.25, s*0.7), min(1.0, v*1.25))]
    i = 0
    while len(res) < 5:
        res.append(vars_[i % 5]); i += 1
    return res[:5]

def extract_image_colors(img_path):
    if Image is None or not img_path.exists():
        return parse_noctalia()
    with Image.open(img_path) as im:
        im = im.convert("RGB")
        im.thumbnail((192, 108), Image.Resampling.BILINEAR)
        q = im.quantize(colors=24, method=Image.Quantize.MEDIANCUT)
        pal = q.getpalette() or []
        counts = q.getcolors(maxcolors=256) or []
    scored, all_c = [], []
    for cnt, idx in counts:
        r, g, b = pal[idx*3:idx*3+3]
        hx = f"{r:02x}{g:02x}{b:02x}"
        h, s, v = colorsys.rgb_to_hsv(r/255.0, g/255.0, b/255.0)
        all_c.append((cnt, hx, h, s, v))
        if v >= 0.16 and not (s < 0.12 and v > 0.90):
            scored.append(((s ** 1.35) * (v ** 0.65) * (cnt ** 0.35), hx, h, s, v))
    if not scored:
        scored = [(cnt * (v + 0.1), hx, h, s, v) for cnt, hx, h, s, v in all_c]
    scored.sort(key=lambda x: x[0], reverse=True)
    distinct = []
    for _, hx, h, s, v in scored:
        if all(min(abs(h - dh), 1.0 - abs(h - dh)) > 0.045 or abs(v - dv) > 0.18 for _, dh, _, dv in distinct):
            distinct.append((hx, h, s, v))
        if len(distinct) >= 12: break
    if not distinct:
        distinct = [(hx, h, s, v) for _, hx, h, s, v in scored[:6]]
    _, ph, ps, pv = distinct[0]
    c = {"active_border_color": hsv_to_hex(ph, max(ps, min(1.0, ps*1.12)), max(pv, 0.58))}
    keys = ("color1","color2","color3","color5","color6","color9","color10","color11","color13","color14","color4","color12")
    for i, k in enumerate(keys):
        _, h, s, v = distinct[i % len(distinct)]
        c[k] = hsv_to_hex(h, max(s, min(1.0, s*1.08)), max(v, 0.50))
    return c

def build_modes(c):
    p = c.get("active_border_color") or c.get("color2") or c.get("color1") or "7aa2f7"
    p_green = is_green(p)
    pool = uniq([c.get(k, "") for k in ("active_border_color","color1","color2","color3","color5","color6","color9","color10","color11","color13","color14","color4","color12")]) or ["7aa2f7","bb9af7","f7768e","e0af68","7dcfff"]
    filt = [x for x in pool if p_green or not is_green(x)]
    if len(filt) < 3: filt = pad5(filt, p)
    ph, ps, pv = hex_to_hsv(p)
    hi = hsv_to_hex(ph, max(0.25, ps*0.78), min(1.0, max(pv, 0.88)*1.08))
    lo = hsv_to_hex(ph, min(1.0, ps*1.08), max(0.42, pv*0.75))
    pick = lambda k, fb: c.get(k, "") if c.get(k, "") and (p_green or not is_green(c.get(k, ""))) else fb
    m0 = pad5(uniq([p, pick("color10", hi), pick("color1", lo), pick("color14", hi), pick("color5", p)]), p)
    m1 = sorted(pad5(sorted(filt, key=lambda x: hex_to_hsv(x)[1], reverse=True)[:5], p), key=lambda x: hex_to_hsv(x)[0])
    mid, out = (filt[1] if len(filt) > 1 else hi), (filt[2] if len(filt) > 2 else lo)
    m2 = [out, mid, p, mid, out]
    m3 = sorted(pad5(filt[:5], p), key=lambda x: hex_to_hsv(x)[2])
    m4 = pad5(uniq([c.get(k, "") for k in ("color1","color2","color3","color4","color5","color6")]), p)
    m5 = [p] * 5
    return [
        {"name": "Accent & Glow", "colors": [f"#{x}" for x in m0]},
        {"name": "Vibrant Wave", "colors": [f"#{x}" for x in m1]},
        {"name": "Symmetric Core", "colors": [f"#{x}" for x in m2]},
        {"name": "Luminance Flow", "colors": [f"#{x}" for x in m3]},
        {"name": "Full Material", "colors": [f"#{x}" for x in m4]},
        {"name": "Solid Accent", "colors": [f"#{x}" for x in m5]},
    ]

def hex_to_bgr(h):
    h = h.lstrip("#")
    return (int(h[4:6], 16) << 16) | (int(h[2:4], 16) << 8) | int(h[0:2], 16)

def apply_openrgb(hex_list):
    bgr = [hex_to_bgr(x) for x in hex_list]
    leds = [bgr[0]] + bgr
    if base_profile.exists():
        data = json.loads(base_profile.read_text(encoding="utf-8"))
        data["profile_name"] = "NoctaliaSync"
        for ctrl in data.get("controllers", []):
            if "Gaming Keyboard G213" in ctrl.get("name", ""):
                ctrl["active_mode"] = 0; ctrl["colors"] = leds; break
        tmp = target_profile.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, indent=4), encoding="utf-8")
        os.replace(tmp, target_profile)
    subprocess.run(["openrgb", "--client", "127.0.0.1:6742", "-p", "NoctaliaSync"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3, check=False)

def load_cache():
    if wall_cache_file.exists():
        try:
            d = json.loads(wall_cache_file.read_text(encoding="utf-8"))
            if isinstance(d, dict): return d
        except Exception: pass
    return {}

def save_cache(d):
    tmp = wall_cache_file.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(d, separators=(",", ":")), encoding="utf-8")
    os.replace(tmp, wall_cache_file)

def cached_modes(img_path, d):
    key = str(img_path)
    try: mtime = int(img_path.stat().st_mtime)
    except OSError: return None, False
    ent = d.get(key)
    if isinstance(ent, dict) and ent.get("mtime") == mtime and isinstance(ent.get("modes"), list):
        return ent["modes"], False
    modes = build_modes(extract_image_colors(img_path))
    d[key] = {"mtime": mtime, "modes": modes}
    return modes, True

ap = argparse.ArgumentParser()
ap.add_argument("--mode", type=int, default=None)
ap.add_argument("--next", action="store_true")
ap.add_argument("--prev", action="store_true")
ap.add_argument("--export-only", action="store_true")
ap.add_argument("--image", type=str, default=None)
ap.add_argument("--warm", nargs="?", const="", default=None)
args = ap.parse_args()

cache_dir.mkdir(parents=True, exist_ok=True)
wcache = load_cache()

if args.warm is not None:
    rdir = pathlib.Path(args.warm).expanduser() if args.warm else walls_root
    exts = {".jpg", ".jpeg", ".png", ".webp"}
    dirty, seen = False, set()
    if rdir.exists():
        for p in sorted(rdir.rglob("*")):
            if p.is_file() and p.suffix.lower() in exts:
                seen.add(str(p))
                _, ch = cached_modes(p, wcache)
                dirty = dirty or ch
        for k in [k for k in wcache if k.startswith(str(rdir)) and k not in seen]:
            del wcache[k]; dirty = True
    if dirty or not wall_cache_file.exists():
        save_cache(wcache)
    sys.exit(0)

active = int(state_file.read_text().strip()) if state_file.exists() and state_file.read_text().strip().isdigit() else 0
if args.image:
    modes, dirty = cached_modes(pathlib.Path(args.image).expanduser(), wcache)
    if modes is None: modes = build_modes(parse_noctalia())
    if dirty: save_cache(wcache)
else:
    modes = build_modes(parse_noctalia())
    lw = pathlib.Path("/tmp/wallfx-last.txt")
    if lw.exists():
        wp = pathlib.Path(lw.read_text(encoding="utf-8").strip())
        if wp.exists():
            try:
                wcache[str(wp)] = {"mtime": int(wp.stat().st_mtime), "modes": modes}
                save_cache(wcache)
            except OSError: pass

if args.mode is not None: active = args.mode % len(modes)
elif args.next: active = (active + 1) % len(modes)
elif args.prev: active = (active - 1) % len(modes)
else: active = active % len(modes)

state_file.write_text(f"{active}\n", encoding="utf-8")
tmp_m = modes_file.with_suffix(".json.tmp")
tmp_m.write_text(json.dumps({"active": active, "modes": modes}, indent=2), encoding="utf-8")
os.replace(tmp_m, modes_file)
if not args.export_only: apply_openrgb(modes[active]["colors"])
