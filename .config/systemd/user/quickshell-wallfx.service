[Unit]
Description=Quickshell WallFX Shader Transitions & Wallpaper Picker
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
ExecStart=/usr/bin/qs -p %h/.config/quickshell-wallfx
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
